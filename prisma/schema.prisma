// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS für feste Werte ---

enum UserRole {
  user
  admin
  merchant
}

enum MerchantStatus {
  pending
  active
  suspended
}

model User {
  id            String    @id @default(cuid()) @map("id")
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  premium       Boolean   @default(false)
  role          UserRole  @default(user) // Enum statt String
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    Int? /// Unix timestamp for ban expiration
  otpCode       String?
  otpExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid()) @map("id")
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid()) @map("id")
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  idToken String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Merchant {
  id        String         @id @default(cuid())
  name      String         @unique
  address   String
  web       String
  phone     String
  email     String
  partners  Partner[] // Mehrzahl, da 1:n
  status    MerchantStatus @default(pending) // Enum statt String
  products  Product[] // 1:n zu Product
  createdAt DateTime       @default(now()) @db.Timestamp(6)
  updatedAt DateTime       @updatedAt @db.Timestamp(6)
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String
  department String
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)
  Merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId String
}

model Product {
  id          String    @id @default(cuid())
  merchantId  String
  name        String
  smallDesc   String
  longDesc    String
  isActive    Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  brand       String
  subcategory String?
  rating      Decimal   @default(0) @db.Decimal(4, 2)
  numReviews  Int       @default(0)
  slug        String    @unique
  categoryId  String
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)
  variants    Variant[]
  category    Category  @relation(fields: [categoryId], references: [id])
  merchant    Merchant  @relation(fields: [merchantId], references: [id]) // Relation ergänzt

  @@index([merchantId])
  @@index([categoryId, isActive])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  units     String? // z.B. "kg", "l", "pcs"
  size      String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   Option[]
}

model Option {
  id            String   @id @default(cuid())
  variantId     String
  color         String
  entryPrice    Decimal  @default(0) @db.Decimal(6, 2)
  sellPrice     Decimal  @default(0) @db.Decimal(6, 2)
  taxPercentage Decimal  @default(0) @db.Decimal(4, 2)
  quantity      Int
  sku           String?  @unique
  image         String[]
  weight        Decimal  @default(0) @db.Decimal(6, 2)
  stockLevel    Int
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
}
